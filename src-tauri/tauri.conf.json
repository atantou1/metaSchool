{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "metaSchool",
  "version": "1.0.0",
  "identifier": "com.metaschool.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "title": "metaSchool - Ωρολόγιο Πρόγραμμα",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend",
      "binaries/node"
    ],
    "resources": [
      "resources/standalone"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
